# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres — MUST use the Transaction pooler (port 6543) with the
# app_backend role. The direct connection (db.<ref>.supabase.co:5432) only
# resolves to an IPv6 address, which Heroku dynos (and most Docker
# networks) cannot reach — using it makes every query fail with
# "Network unreachable" in production even though it works from a host
# that has IPv6 egress (e.g. some ISPs/laptops).
#
# The pooler node number (aws-0- vs aws-1- vs aws-2-...) AND region are
# per-project, not a fixed value — copy the exact string from Supabase
# Dashboard → Project Settings → Database → Connect → "Transaction pooler"
# tab, then swap its default `postgres` user for `app_backend` (same
# `.<PROJECT_REF>` suffix) to keep RLS impersonation working.
# Format: postgresql://app_backend.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://app_backend.yburqxpgzcymdyolbiqg:CHANGE_ME@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10

# JWT secret from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Public Supabase credentials (used only to proxy login to Supabase Auth)
SUPABASE_URL=https://yburqxpgzcymdyolbiqg.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional Redis for distributed rate limiting / login lockout.
# If empty, an in-memory store is used (fine for single instance).
REDIS_URL=

# Login hardening
LOGIN_ATTEMPTS_BEFORE_COOLDOWN=3
LOGIN_COOLDOWN_MS=60000
LOGIN_ATTEMPTS_BEFORE_BLOCK=9

# Invitaciones a diagramas (opcional). Sin estas dos variables no se envían
# correos: el modal de compartir ofrece "Copiar enlace de invitación".
RESEND_API_KEY=
MAIL_FROM=
# URL pública del frontend para los enlaces /invite/:token (por defecto, el
# primer origen de CORS_ORIGIN).
APP_URL=

# Colaboración en tiempo real (WebSocket en /realtime). Con más de una
# instancia del API, configura REDIS_URL para que se vean entre sí.
REALTIME_ENABLED=true
