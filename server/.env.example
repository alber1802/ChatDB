# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres — use the Transaction pooler (port 6543) with the app_backend role
# Format (pooler): postgresql://app_backend.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Format (direct): postgresql://app_backend:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://app_backend.yburqxpgzcymdyolbiqg:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10

# JWT secret from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Public Supabase credentials (used only to proxy login to Supabase Auth)
SUPABASE_URL=https://yburqxpgzcymdyolbiqg.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional Redis for distributed rate limiting / login lockout.
# If empty, an in-memory store is used (fine for single instance).
REDIS_URL=

# Login hardening
LOGIN_ATTEMPTS_BEFORE_COOLDOWN=3
LOGIN_COOLDOWN_MS=60000
LOGIN_ATTEMPTS_BEFORE_BLOCK=9
