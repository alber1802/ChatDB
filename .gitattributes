# Force LF line endings for all text files, regardless of each clone's
# local core.autocrlf setting. Without this, Windows checkouts with
# core.autocrlf=true write CRLF to disk, which breaks the prettier/eslint
# lint step and any test that compares generated output against a
# checked-in fixture file (both expect LF).
* text=auto eol=lf

# Known binary types: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
