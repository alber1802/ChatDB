# Build artifacts
node_modules
dist
build

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files. NOT excluding .env.docker (see Dockerfile's
# explicit `COPY .env.docker .env`) — this only excludes bare `.env` and
# any `.local` variant. Without this, `.env.local` (VITE_API_URL pointing
# at localhost for local dev) leaks into the build context via `COPY . .`
# and Vite loads it with HIGHER priority than the `.env` written from
# `.env.docker`, silently baking `http://localhost:3001` into production
# builds instead of the real backend URL.
.env
.env.local
.env.*.local

# Docker config files themselves
Dockerfile
docker-compose.yml

# Git
.git
.gitignore

# IDE and editor settings
.vscode/
.idea/

# Tests and documentation
__tests__/
test/
tests/
spec/
*.md

# Temporary and OS files
*.swp
*.swo
*.DS_Store
*.log
*.tmp

# Coverage output
# coverage

# NOTE: pnpm-lock.yaml is intentionally NOT excluded.
# It is required by `pnpm install --frozen-lockfile` for deterministic builds.
# npm's package-lock.json is excluded (not needed when using pnpm).

package-lock.json